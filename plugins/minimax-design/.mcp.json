{
  "mcpServers": {
    "minimax-design": {
      "url": "http://127.0.0.1:18810/mcp"
    },
    "minimax-design-compute": {
      "command": "uvw",
      "args": [
        "run",
        "--no-project",
        "--no-python-downloads",
        "--python",
        ">=3.11",
        "python",
        "-B",
        "${PLUGIN_ROOT}/server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
